config/
.privacy-denylist
.venv/
__pycache__/
*.pyc
.pytest_cache/
state.json
.DS_Store

# Default output tree (settings.yaml `output_dir`) — day folders hold a
# user's real search record: companies, comp, full JD text. Never
# committable by accident. If you point `output_dir` outside the repo, that
# location is your own responsibility to keep private.
radar-out/

# Per-application drafts (cover letters, tailored resumes, etc.) hold real
# personal data — never committable by accident.
apply-out/

# Custom templates registered via /add-template may embed personal header data.
templates/custom/

# Archived applications (settings.yaml `archive_dir`) hold real personal
# data — resumes, cover letters, JD text, outcome logs. Never committable
# by accident, same rule as apply-out/ above.
archive/

# tools/demo.py's default output — fictional data only, but it's a scratch
# tree regenerated on every run, not something to track.
demo-out/
